<?xml version="1.0" encoding="UTF-8"?>
<!-- noupdate: адміністратор може змінити розклад чи вимкнути задачу,
     і -u цього не затре -->
<odoo noupdate="1">

    <!-- Раз на місяць, першого числа: активності на ювілеї видання -->
    <record id="osl_ir_cron_publication_anniversary" model="ir.cron">
        <field name="name">Library: Publication anniversaries</field>
        <field name="model_id" ref="model_odoo_school_library_book"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_publication_anniversary()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="nextcall" eval="(DateTime.now().replace(day=1) + relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00')"/>
    </record>

</odoo>
