<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-Generated/Assisted Code
     Details tracked via `Assisted-by:` trailers in git log -->
<odoo>

    <template id="library_books_page" name="Books in use">
        <t t-call="web.frontend_layout">
            <div class="container">
                <div class="o_logo">
                    <img t-attf-src="/web/binary/company_logo?company={{ company.id }}" alt="Logo"/>
                </div>
                <div class="card">
                    <div class="card-header">
                        <h2>Books in use of <small><t t-out="reader.name"/></small></h2>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <tr>
                                    <th>Title</th>
                                    <th>Author</th>
                                </tr>
                                <tr t-foreach="books" t-as="book">
                                    <td><t t-out="book.name"/></td>
                                    <td><t t-out="book.author_id.display_name"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
