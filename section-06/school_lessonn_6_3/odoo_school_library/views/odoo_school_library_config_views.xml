<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Налаштування нумерації: послідовність інвентарних номерів з data/ -->
    <record id="action_odoo_school_library_book_sequence" model="ir.actions.act_window">
        <field name="name">Book Numbering</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('code', '=', 'odoo.school.library.book')]</field>
        <field name="context">{'default_code': 'odoo.school.library.book'}</field>
    </record>

    <menuitem id="odoo_school_library_menu_config_sequence"
              name="Book Numbering"
              parent="odoo_school_library_menu_config"
              action="action_odoo_school_library_book_sequence"
              sequence="10"/>

    <!-- Теги "Автор" і "Читач" з data/ - через стандартний action модуля base -->
    <menuitem id="odoo_school_library_menu_config_tags"
              name="Partner Tags"
              parent="odoo_school_library_menu_config"
              action="base.action_partner_category_form"
              sequence="20"/>

</odoo>
